# CabinSafe Intelligence — environment variables
# Copy to .env.local for local development. Never commit real values.
# All variables are optional: without them the app runs as a fully functional
# demonstration with on-device persistence and a labelled deterministic assistant.

# ── Live AI Safety Copilot (server-side only; never exposed to the browser) ──
# Enables live answers from Claude via the official Anthropic SDK.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
COPILOT_MODEL=

# ── Hosted database & authentication (production path; not yet wired in the client) ──
# Apply supabase/schema.sql to your project first. The anon key is safe for the
# browser ONLY because row-level security is enabled on every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Official public feeds (NOAA AWC, U.S. State Dept, USGS, GDACS, CDC) require no keys.
